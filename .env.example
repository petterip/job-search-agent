# Docker Compose
APP_VERSION=local
WEB_BIND=127.0.0.1
WEB_PORT=3080
API_BIND=127.0.0.1
API_PORT=8008

# Database
POSTGRES_USER=jobsearchagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobsearchagent
DATABASE_URL=postgresql+psycopg://jobsearchagent:change-me@db:5432/jobsearchagent

# API URLs
INTERNAL_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8008

# Private access boundary (P0-9). When OPERATOR_API_TOKEN is set, the API
# requires it for /recommendations* reads and for every non-GET request; the
# web app forwards it server-side. PUBLIC_ORIGIN is the browser-facing origin
# used for same-origin checks on form POSTs. Leave empty only for local dev.
OPERATOR_API_TOKEN=
PUBLIC_ORIGIN=

# Hosted LLM scoring
# Leave LLM_PROVIDER empty to disable hosted LLM calls.
# Supported values: openai, gemini
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EVAL_MODEL=gpt-5.4-nano
OPENAI_EVAL_MODEL_ESCALATED=gpt-5.4-mini
OPENAI_EVAL_TIMEOUT_SECONDS=180
GEMINI_API_KEY=
GEMINI_EVAL_MODEL=gemini-3.5-flash
LLM_EVAL_BATCH_SIZE=8
LLM_EVAL_MAX_JOBS=800
LLM_PROVIDER_FAILURE_COOLDOWN_MIN=360
LLM_PROMPT_VERSION=8
FEEDBACK_ANALYSIS_POLL_MINUTES=5
LEARNER_DAILY_HOUR=16
LEARNER_DAILY_MINUTE=45
LEARNED_DISCOVERY_QUERY_CAP=12
LEARNED_EXCLUSION_CAP=40
FEEDBACK_DECAY_HALF_LIFE_DAYS=60
MATCHER_MAX_JOBS=1000
MATCHER_LOCAL_MAX_JOBS=1000
MATCHER_REMOTE_MAX_JOBS=500

# Collector
# Worker schedule uses Europe/Helsinki time. Sources run first; the ordered learn/enrich/match pipeline runs after collection.
COLLECTOR_DAILY_HOUR=16
COLLECTOR_DAILY_MINUTE=0
COLLECTOR_ENABLED_SOURCES=duunitori,tmt,tmt_oulu,laura,jobly,eures_fi,kuntarekry,kirkkorekry,oulu_varbi
# Extra recall searches merged into broad incremental runs for high-value role families.
DISCOVERY_SEARCH_QUERIES=kirjastonhoitaja,kirjastovirkailija,kirjasto,informaatikko,kirjastopedagogi,musiikkikirjasto,musiikkitapahtumat,sisällöntuottaja,sisällöntuotanto,viestintäasiantuntija,tiedottaja,koordinaattori,projektikoordinaattori,projektiassistentti,hallintoassistentti,toimistoassistentti,johdon assistentti,tapahtumakoordinaattori,kulttuurituottaja
DUUNITORI_PAGE_SIZE=100
DUUNITORI_MAX_PAGES=50
TMT_PAGE_SIZE=90
TMT_MAX_PAGES=130
LAURA_PAGE_SIZE=100
LAURA_MAX_PAGES=5
JOBLY_MAX_URLS_PER_RUN=100
EURES_PAGE_SIZE=50
EURES_MAX_PAGES=5
COLLECTOR_STALE_RUN_MINUTES=30
KUNTAREKRY_COLLECTION_MODE=regional

# Google Maps transit distance (Routes API, server-side key)
GOOGLE_MAPS_API_KEY=
TRANSIT_ORIGIN_ADDRESS="Jalkatie 2, Oulu, Finland"
RECOMMENDATION_COMMUTE_LIMIT_MINUTES=120
RECOMMENDATION_TRANSIT_LOOKUP_BUDGET=100

# Browser enrichment (Browserbase cloud browser)
# Keep ENRICHMENT_ENABLED=false unless browser/detail enrichment has been explicitly enabled for this environment.
BROWSERBASE_API_KEY=
ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER=browserbase
ENRICHMENT_MAX_JOBS_PER_RUN=50
ENRICHMENT_SHORT_DESCRIPTION_CHARS=200
JOBLY_BROWSER_ENRICH_MAX_PER_RUN=20
CAREERJET_API_KEY=
CAREERJET_MAX_RESULTS_PER_RUN=50
CAREERJET_USER_IP=127.0.0.1
LINKEDIN_ENABLED=false
LINKEDIN_MAX_RESULTS_PER_RUN=100
LINKEDIN_REQUEST_DELAY_SECONDS=2.0
LINKEDIN_SEARCH_QUERIES=kirjastonhoitaja,kirjastovirkailija,informaatikko,information specialist,library,content producer,sisällöntuottaja,kulttuurituottaja,museo,arkisto
LINKEDIN_BROWSER_ENRICH_MAX_PER_RUN=10
