# Keep codebase-memory indexing focused on source, docs, and configuration.

# VCS and local agent/cache artifacts
.git/
.codebase-memory/tmp/

# Secrets and private profile data
.env
.env.*
profile/**
!profile/
!profile/README.md

# Python caches, virtualenvs, and build outputs
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Node dependencies and generated frontend output
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Tool caches, reports, and local runtime state
.cache/
.turbo/
.vercel/
.vite/
tmp/
temp/
*.log
logs/
playwright-report/
test-results/
reports/

# Local databases, queue state, backups, and archives
*.sqlite
*.sqlite3
*.db
*.db-journal
*.rdb
dump.rdb
backups/
*.bak
*.orig
*.rej
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
